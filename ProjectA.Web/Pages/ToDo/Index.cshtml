@page
@model ProjectA.Web.Pages.ToDo.IndexModel
@{
    ViewData["Title"] = "ToDo items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>ToDo items</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="Create" class="btn btn-primary">Create ToDo</a>
    }
</div>

<div class="form-check mb-2">
    <input class="form-check-input" type="checkbox" id="includeDone"
           onchange="location.href='@Url.Page("Index", new { includeDone = !Model.IncludeDone, showProjectItems = Model.ShowProjectItems })'"
           @(Model.IncludeDone ? "checked" : "") />
    <label class="form-check-label" for="includeDone">Show completed items</label>
</div>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="showProjectItems"
           onchange="location.href='@Url.Page("Index", new { includeDone = Model.IncludeDone, showProjectItems = !Model.ShowProjectItems })'"
           @(Model.ShowProjectItems ? "checked" : "") />
    <label class="form-check-label" for="showProjectItems">Show Project related items</label>
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load ToDo items from the API.</div>
}
else
{
    @* ToDos with no Project association - uncategorized items list first (their own group, if
       any), then each category's items - see IndexModel.GroupedToDoItems / ToDoGrouping. *@
    if (Model.GroupedToDoItems.Count == 0)
    {
        <p class="text-muted">Nothing here.</p>
    }
    else
    {
        foreach (var group in Model.GroupedToDoItems)
        {
            <h2 class="h5 mt-4">@(group.IsUncategorized ? "Uncategorized" : group.CategoryTitle)</h2>
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Done</th>
                        <th>Title</th>
                        <th>Description</th>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in group.Items)
                    {
                        <tr class="@(item.Done ? "text-decoration-line-through text-muted" : "")">
                            <td>@(item.Done ? "Yes" : "No")</td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td class="text-end">
                                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline"
                                          onsubmit="return confirm('Delete this ToDo item?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (Model.ShowProjectItems)
    {
        <h2 class="h4 mt-5">Project ToDo items</h2>

        @* Project-associated ToDos, grouped by Project (alphabetically), each Project's own
           items then grouped Uncategorized-first/by-Category the same way as above - see
           IndexModel.GroupedProjectToDoItems / ToDoGrouping. *@
        if (Model.GroupedProjectToDoItems.Count == 0)
        {
            <p class="text-muted">No Project ToDo items.</p>
        }
        else
        {
            foreach (var projectGroup in Model.GroupedProjectToDoItems)
            {
                <h3 class="h5 mt-3">@projectGroup.ProjectTitle</h3>
                foreach (var group in projectGroup.CategoryGroups)
                {
                    <h4 class="h6 text-muted mt-2">@(group.IsUncategorized ? "Uncategorized" : group.CategoryTitle)</h4>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Done</th>
                                <th>Title</th>
                                <th>Description</th>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <th class="text-end">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group.Items)
                            {
                                <tr class="@(item.Done ? "text-decoration-line-through text-muted" : "")">
                                    <td>@(item.Done ? "Yes" : "No")</td>
                                    <td>@item.Title</td>
                                    <td>@item.Description</td>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <td class="text-end">
                                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline"
                                                  onsubmit="return confirm('Delete this ToDo item?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
    }
}
