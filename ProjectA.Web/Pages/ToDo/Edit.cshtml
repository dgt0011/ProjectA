@page "{id:long}"
@model ProjectA.Web.Pages.ToDo.EditModel
@{
    ViewData["Title"] = "Edit ToDo";
}

<h1>Edit ToDo</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.CategoryId" class="form-label"></label>
        @if (Model.AvailableCategories.Count == 0)
        {
            <p class="text-muted">No categories exist yet.</p>
        }
        else
        {
            <select asp-for="Form.CategoryId" class="form-select">
                <option value="">Select a category...</option>
                @foreach (var category in Model.AvailableCategories)
                {
                    <option value="@category.Id">@category.Title</option>
                }
            </select>
        }
        <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Description" class="form-label"></label>
        <textarea asp-for="Form.Description" class="form-control"></textarea>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Form.Done" class="form-check-input" />
        <label asp-for="Form.Done" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>
