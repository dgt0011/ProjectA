@page
@model ProjectA.Web.Pages.Blog.SettingsModel
@{
    ViewData["Title"] = "Blog settings";
}

<h1>Blog</h1>

<partial name="_BlogNav" model="@("Settings")" />

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" enctype="multipart/form-data" class="col-lg-8">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Description" class="form-label"></label>
        <input asp-for="Form.Description" class="form-control" />
        <div class="form-text">Shown under the title in the blog header.</div>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Form.ItemsPerPage" class="form-label"></label>
            <input asp-for="Form.ItemsPerPage" class="form-control" min="1" max="100" />
            <span asp-validation-for="Form.ItemsPerPage" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="Form.IncludeFeatured" class="form-check-input" />
                <label asp-for="Form.IncludeFeatured" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Cover" class="form-label"></label>
        <input asp-for="Form.Cover" class="form-control mb-2" placeholder="img/cover.jpg" />
        <input asp-for="CoverFile" type="file" accept="image/*" class="form-control" />
        <div class="form-text">Used for posts without their own cover image.</div>
        <span asp-validation-for="CoverFile" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Logo" class="form-label"></label>
        <input asp-for="Form.Logo" class="form-control" />
        <span asp-validation-for="Form.Logo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.HeaderScript" class="form-label"></label>
        <textarea asp-for="Form.HeaderScript" class="form-control font-monospace" rows="5"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Form.FooterScript" class="form-label"></label>
        <textarea asp-for="Form.FooterScript" class="form-control font-monospace" rows="5"></textarea>
        <div class="form-text">E.g. analytics code. Injected unescaped into every public page.</div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
