@page "{id:long}"
@model ProjectA.Web.Pages.Blog.Categories.EditModel
@{
    ViewData["Title"] = "Edit blog category";
}

<h1>Edit blog category</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <div class="form-text">Renaming changes the category's public URL.</div>
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Description" class="form-label"></label>
        <input asp-for="Form.Description" class="form-control" />
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>
