@page
@model ProjectA.Web.Pages.Blog.LoginModel
@*
    Blog sign-in. Deliberately not ProjectA's _Layout: it is a standalone page in the public
    blog's "standard" theme (same header, Bootstrap 5.0 beta and theme stylesheet, loaded from
    the blog site itself), so it reads as part of the blog. No ProjectA navigation or branding.
*@
@{
    Layout = null;
    var blogUrl = Model.BlogSiteUrl ?? "/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Sign in | @Model.BlogTitle</title>
    <link rel="icon" href="data:,">

    <style>
        :root {
            --bf-color: #622aff;
            --bf-header-title-size: 1.5rem;
            --bf-header-title-weight: 700;
            --bf-header-title-color: #000;
            --bf-header-title-hover: #622aff;
            --bf-header-logo-width: auto;
            --bf-header-logo-height: 1.5rem;
            --bf-post-width: 43.75rem;
            --bf-radius: .5rem;
        }

        /* More specific than Bootstrap's .container widths, which load after this block. */
        .login .login-container { max-width: 24rem; }
        .login .form-control { border-radius: var(--bf-radius); padding: .75rem 1rem; }
        .login .form-control:focus { border-color: var(--bf-color); box-shadow: 0 0 0 .2rem rgba(98, 42, 255, .15); }
        .login-button {
            background: var(--bf-color); border: 0; color: #fff; border-radius: var(--bf-radius);
            padding: .75rem 1rem; font-weight: 600; width: 100%;
        }
        .login-button:hover, .login-button:focus { background: #4f1fd9; color: #fff; }
        .login-back { color: #6c757d; text-decoration: none; }
        .login-back:hover { color: var(--bf-color); }
    </style>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    @if (Model.BlogSiteUrl is not null)
    {
        <link rel="stylesheet" href="@Model.BlogSiteUrl/themes/standard/css/styles.css">
    }
</head>

<body>

<header class="header">
    <div class="container d-md-flex align-items-md-center">
        <section class="header-sign py-4 py-md-0 text-center text-md-start me-md-auto">
            <a class="header-title" href="@blogUrl">@Model.BlogTitle</a>
            @if (!string.IsNullOrWhiteSpace(Model.BlogDescription))
            {
                <p class="header-desc">@Model.BlogDescription</p>
            }
        </section>
    </div>
</header>

<main class="login py-5">
    <div class="login-container container">
        <h1 class="post-title text-center mb-4">Sign in</h1>

        @if (ViewData.ModelState.ErrorCount > 0 && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Form.Username" class="form-label">Username</label>
                <input asp-for="Form.Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Form.Username" class="small text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Form.Password" class="form-label">Password</label>
                <input asp-for="Form.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Form.Password" class="small text-danger"></span>
            </div>
            <button type="submit" class="login-button">Sign in</button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a class="login-back" href="@blogUrl">&larr; Back to the blog</a>
        </p>
    </div>
</main>

<footer class="container">
    <section class="footer d-md-flex text-center text-md-start py-4 py-md-5">
        <p>&copy; @DateTime.UtcNow.Year - @Model.BlogTitle</p>
    </section>
</footer>

</body>
</html>
