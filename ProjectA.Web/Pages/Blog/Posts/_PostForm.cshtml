@model ProjectA.Web.Pages.Blog.Posts.BlogPostFormPageModel
@* Shared by Create and Edit. multipart/form-data so the optional cover file can be posted with
   the rest of the form. *@

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" enctype="multipart/form-data" id="blog-post-form">
    <input type="hidden" asp-for="Form.PostType" />
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mb-3">
                <label asp-for="Form.Title" class="form-label"></label>
                <input asp-for="Form.Title" class="form-control form-control-lg" />
                <span asp-validation-for="Form.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Description" class="form-label"></label>
                <textarea asp-for="Form.Description" class="form-control" rows="2" maxlength="450"></textarea>
                <span asp-validation-for="Form.Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Content" class="form-label"></label>
                <textarea asp-for="Form.Content" class="form-control" rows="20"></textarea>
                <div class="form-text">Drag &amp; drop or paste an image into the editor to upload it.</div>
                <span asp-validation-for="Form.Content" class="text-danger"></span>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-check form-switch mb-2">
                <input asp-for="Form.IsPublished" class="form-check-input" role="switch" />
                <label asp-for="Form.IsPublished" class="form-check-label"></label>
            </div>
            @if (!Model.IsPage)
            {
                <div class="form-check form-switch mb-3">
                    <input asp-for="Form.IsFeatured" class="form-check-input" role="switch" />
                    <label asp-for="Form.IsFeatured" class="form-check-label"></label>
                </div>
            }
            <div class="mb-3">
                <label asp-for="Form.Slug" class="form-label"></label>
                <input asp-for="Form.Slug" class="form-control" />
                <span asp-validation-for="Form.Slug" class="text-danger"></span>
            </div>
            @if (!Model.IsPage)
            {
                <div class="mb-3">
                    <label asp-for="Form.CategoriesText" class="form-label"></label>
                    <input asp-for="Form.CategoriesText" class="form-control" list="blog-category-options" autocomplete="off" />
                    <datalist id="blog-category-options">
                        @foreach (var category in Model.AvailableCategories)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                    @if (Model.AvailableCategories.Count > 0)
                    {
                        <div class="form-text">Existing: @string.Join(", ", Model.AvailableCategories)</div>
                    }
                    <span asp-validation-for="Form.CategoriesText" class="text-danger"></span>
                    @* API validation errors arrive keyed by its request property name, "Categories". *@
                    @Html.ValidationMessage("Form.Categories", new { @class = "text-danger" })
                </div>
            }
            <div class="mb-3">
                <label asp-for="Form.Cover" class="form-label"></label>
                <input asp-for="Form.Cover" class="form-control mb-2" placeholder="e.g. /data/2024/05/cover.jpg" />
                <input asp-for="CoverFile" type="file" accept="image/*" class="form-control" />
                <div class="form-text">Choosing a file uploads it and replaces the path above.</div>
                <span asp-validation-for="Form.Cover" class="text-danger"></span>
                <span asp-validation-for="CoverFile" class="text-danger"></span>
                @if (!string.IsNullOrWhiteSpace(Model.Form.Cover))
                {
                    <img src="@(Model.Form.Cover.StartsWith("http") || Model.Form.Cover.StartsWith("/") ? Model.Form.Cover : "/" + Model.Form.Cover)"
                         alt="Current cover" class="img-fluid rounded mt-2" />
                }
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" asp-route-type="@Model.Form.PostType" class="btn btn-link">Cancel</a>
        </div>
    </div>
</form>
