@page
@model ProjectA.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Projects</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Projects/Create" class="btn btn-primary">Create project</a>
    }
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load projects.</div>
}
else if (Model.Projects.Count == 0)
{
    <p class="text-muted">No projects yet.</p>
}
else
{
    <div class="row g-4">
    
        @foreach (var project in Model.Projects)
        {
                
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            @project.Title
                            @if (project.IsPrivate)
                            {
                                <span class="badge text-bg-secondary">Private</span>
                            }
                        </h5>
                        <p class="card-text text-muted">@project.Description</p>
                        <!-- <a asp-page="Details" asp-route-id="@project.Id" class="btn btn-primary">View</a> -->
                        <a asp-page="Projects/Details" asp-route-id="@project.Id" class="btn btn-primary">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
}