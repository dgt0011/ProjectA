@page
@{
    ViewData["Title"] = "Home";
}

<div class="px-4 py-5 text-center">
    <h1 class="display-5 fw-bold">ProjectA</h1>
    <p class="col-lg-8 mx-auto text-muted">
        Manage categories, bookmarks, attachments, ToDo items, notes and projects backed by
        the ProjectA.Api service.
    </p>
</div>

<div class="row g-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Categories</h5>
                <p class="card-text text-muted">Group bookmarks and notes under shared labels.</p>
                <a asp-page="/Categories/Index" class="btn btn-primary">Manage categories</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Bookmarks</h5>
                <p class="card-text text-muted">Save links, rate them and tag them with categories.</p>
                <a asp-page="/Bookmarks/Index" class="btn btn-primary">Manage bookmarks</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Attachments</h5>
                <p class="card-text text-muted">Track files stored in S3 by ARN.</p>
                <a asp-page="/Attachments/Index" class="btn btn-primary">Manage attachments</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">ToDo items</h5>
                <p class="card-text text-muted">Track outstanding and completed tasks.</p>
                <a asp-page="/ToDo/Index" class="btn btn-primary">Manage ToDo items</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Notes</h5>
                <p class="card-text text-muted">Write notes with a Markdown editor and live preview.</p>
                <a asp-page="/Notes/Index" class="btn btn-primary">Manage notes</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Projects</h5>
                <p class="card-text text-muted">Track projects and their start dates.</p>
                <a asp-page="/Projects/Index" class="btn btn-primary">Manage projects</a>
            </div>
        </div>
    </div>
</div>
