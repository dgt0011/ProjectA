@page "{id:long}"
@model ProjectA.Web.Pages.Projects.DetailsModel
@{
    ViewData["Title"] = Model.Project?.Title ?? "Project";
}

@if (Model.Project is null)
{
    <div class="alert alert-warning">Could not load this project from the API.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h1>@Model.Project.Title</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="Edit" asp-route-id="@Model.Project.Id" class="btn btn-outline-secondary">Edit</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Project.Description))
    {
        <p class="lead text-muted">@Model.Project.Description</p>
    }

    <p class="text-muted small">Start date @Model.Project.StartDate.ToString("yyyy-MM-dd")</p>

    <div class="mt-4">
        <h2 class="h5">Notes</h2>
        @if (Model.AssociatedNotes.Count == 0)
        {
            <p class="text-muted">No notes associated with this project.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var note in Model.AssociatedNotes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-page="/Notes/Details" asp-route-id="@note.Id">
                            @(string.IsNullOrWhiteSpace(note.Title) ? "(untitled note)" : note.Title)
                        </a>
                        <span class="text-muted small">@note.DateCreated.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mt-4">
        <h2 class="h5">Bookmarks</h2>
        @if (Model.AssociatedBookmarks.Count == 0)
        {
            <p class="text-muted">No bookmarks associated with this project.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var bookmark in Model.AssociatedBookmarks)
                {
                    <li class="list-group-item">
                        <a href="@bookmark.Url" target="_blank" rel="noopener">
                            @(string.IsNullOrWhiteSpace(bookmark.Title) ? bookmark.Url : bookmark.Title)
                        </a>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mt-4">
        <h2 class="h5">Attachments</h2>
        @if (Model.AssociatedAttachments.Count == 0)
        {
            <p class="text-muted">No attachments associated with this project.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var attachment in Model.AssociatedAttachments)
                {
                    <li class="list-group-item">
                        @(string.IsNullOrWhiteSpace(attachment.Title) ? "(untitled attachment)" : attachment.Title)
                        <code class="text-muted ms-2">@attachment.S3Arn</code>
                    </li>
                }
            </ul>
        }
    </div>

    <p class="mt-3">
        <a asp-page="Index" class="btn btn-link ps-0">Back to Projects</a>
    </p>
}
