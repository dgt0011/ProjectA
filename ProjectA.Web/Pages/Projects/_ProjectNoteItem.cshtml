@model ProjectA.Web.Models.ProjectNoteItemViewModel
@{
    var note = Model.Note;
    var collapseId = $"project-note-collapse-{note.Id}";

    BookmarkTypeDto? GetBookmarkType(long? bookmarkTypeId) =>
        bookmarkTypeId is long id ? Model.BookmarkTypesById.GetValueOrDefault(id) : null;

    AttachmentTypeDto? GetAttachmentType(long? attachmentTypeId) =>
        attachmentTypeId is long id ? Model.AttachmentTypesById.GetValueOrDefault(id) : null;
}

@* Collapsed by default (no "show" class) so a Project's Notes list reads as a scannable set
   of titles/dates first - expanding one reveals the Note in full, in place, so it can be read
   alongside the Notes immediately before and after it without navigating away. *@
<div class="card mb-2">
    <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <button class="btn btn-sm btn-link p-0 me-2" type="button" data-bs-toggle="collapse"
                        data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" aria-label="Expand note">
                    <img src="~/img/expand.png" alt="" class="collapse-toggle-icon" width="16" height="16" />
                </button>
                <strong>@(string.IsNullOrWhiteSpace(note.Title) ? "(untitled note)" : note.Title)</strong>
                @if (note.IsPrivate)
                {
                    <span class="badge text-bg-secondary ms-2">Private</span>
                }
            </div>
            <span class="text-muted small">
                Created : @note.DateCreated.ToLocalTime().ToString("dd MMM yy")
                @if (note.DateModified is { } modified)
                {
                    <text>| Modified : @modified.ToLocalTime().ToString("dd MMM yy HH:mm")</text>
                }
            </span>
        </div>

        <div class="collapse project-note-collapse mt-2" id="@collapseId">
            @if (!string.IsNullOrWhiteSpace(note.Description))
            {
                <p class="text-muted mb-1">@note.Description</p>
            }
            @if (!string.IsNullOrWhiteSpace(note.Body))
            {
                <textarea class="d-none project-note-body-raw" data-note-id="@note.Id">@note.Body</textarea>
                <div class="border rounded p-2 project-note-body-rendered" data-note-id="@note.Id"></div>
            }

            @if (Model.AssociatedBookmarks.Count > 0)
            {
                <div class="mt-3">
                    <h3 class="h6">Bookmarks</h3>
                    <ul class="list-group">
                        @foreach (var bookmark in Model.AssociatedBookmarks)
                        {
                            var bookmarkType = GetBookmarkType(bookmark.BookmarkTypeId);
                            <li class="list-group-item d-flex align-items-center"
                                style="@(!string.IsNullOrWhiteSpace(bookmarkType?.Color) ? $"background-color: {bookmarkType.Color};" : "")">
                                @if (bookmarkType is { HasIcon: true })
                                {
                                    <img src="/bookmark-types/@bookmarkType.Id/icon" alt="@bookmarkType.Title" width="16" height="16"
                                         title="@bookmarkType.Title" class="me-2" />
                                }
                                <a href="@bookmark.Url" target="_blank" rel="noopener">
                                    @(string.IsNullOrWhiteSpace(bookmark.Title) ? bookmark.Url : bookmark.Title)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (Model.AssociatedAttachments.Count > 0)
            {
                <div class="mt-3">
                    <h3 class="h6">Attachments</h3>
                    <ul class="list-group">
                        @foreach (var attachment in Model.AssociatedAttachments)
                        {
                            var attachmentType = GetAttachmentType(attachment.AttachmentTypeId);
                            <li class="list-group-item d-flex align-items-center"
                                style="@(!string.IsNullOrWhiteSpace(attachmentType?.Color) ? $"background-color: {attachmentType.Color};" : "")">
                                @if (attachmentType is { HasIcon: true })
                                {
                                    <img src="/attachment-types/@attachmentType.Id/icon" alt="@attachmentType.Title" width="16" height="16"
                                         title="@attachmentType.Title" class="me-2" />
                                }
                                @(string.IsNullOrWhiteSpace(attachment.Title) ? "(untitled attachment)" : attachment.Title)
                                <a href="@attachment.FilePath" target="_blank" rel="noopener" class="ms-2">@attachment.FilePath</a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <a asp-page="/Notes/Details" asp-route-id="@note.Id" class="small d-inline-block mt-2">Open as its own note</a>
        </div>
    </div>
</div>
