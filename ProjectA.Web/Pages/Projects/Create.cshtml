@page
@model ProjectA.Web.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "Create project";
}

<h1>Create project</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Description" class="form-label"></label>
        <textarea asp-for="Form.Description" class="form-control"></textarea>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.StartDate" class="form-label"></label>
        <input asp-for="Form.StartDate" class="form-control" />
        <span asp-validation-for="Form.StartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.NoteIds" class="form-label"></label>
        @if (Model.AvailableNotes.Count == 0)
        {
            <p class="text-muted">No notes exist yet.</p>
        }
        else
        {
            <select asp-for="Form.NoteIds" class="form-select" multiple size="@Math.Min(Model.AvailableNotes.Count, 6)">
                @foreach (var note in Model.AvailableNotes)
                {
                    <option value="@note.Id">@(string.IsNullOrWhiteSpace(note.Title) ? "(untitled note)" : note.Title)</option>
                }
            </select>
        }
        <span asp-validation-for="Form.NoteIds" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.BookmarkIds" class="form-label"></label>
        @if (Model.AvailableBookmarks.Count == 0)
        {
            <p class="text-muted">No bookmarks exist yet.</p>
        }
        else
        {
            <select asp-for="Form.BookmarkIds" class="form-select" multiple size="@Math.Min(Model.AvailableBookmarks.Count, 6)">
                @foreach (var bookmark in Model.AvailableBookmarks)
                {
                    <option value="@bookmark.Id">@(string.IsNullOrWhiteSpace(bookmark.Title) ? bookmark.Url : bookmark.Title)</option>
                }
            </select>
        }
        <span asp-validation-for="Form.BookmarkIds" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.AttachmentIds" class="form-label"></label>
        @if (Model.AvailableAttachments.Count == 0)
        {
            <p class="text-muted">No attachments exist yet.</p>
        }
        else
        {
            <select asp-for="Form.AttachmentIds" class="form-select" multiple size="@Math.Min(Model.AvailableAttachments.Count, 6)">
                @foreach (var attachment in Model.AvailableAttachments)
                {
                    <option value="@attachment.Id">@(string.IsNullOrWhiteSpace(attachment.Title) ? attachment.S3Arn : attachment.Title)</option>
                }
            </select>
        }
        <span asp-validation-for="Form.AttachmentIds" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>
