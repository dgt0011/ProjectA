@page
@{
    ViewData["Title"] = "Management";
}

<div class="px-4 py-5 text-center">
    <!--    
    <h1 class="display-5 fw-bold">ProjectA</h1>
    <p class="col-lg-8 mx-auto text-muted">
        Manage categories, bookmarks, attachments, ToDo items, notes and projects backed by
        the ProjectA.Api service.
    </p>
    -->
</div>

<div class="row g-4">
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text text-muted">Group bookmarks and notes under shared labels.</p>
                    <a asp-page="/Categories/Index" class="btn btn-primary">Manage categories</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Bookmark Types</h5>
                    <p class="card-text text-muted">Categorise Bookmarks</p>
                    <a asp-page="/BookmarkTypes/Index" class="btn btn-primary">Manage Bookmark Types</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Attachment Types</h5>
                    <p class="card-text text-muted">Categorise Attachments</p>
                    <a asp-page="/AttachmentTypes/Index" class="btn btn-primary">Manage Attachment Types</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text text-muted">Manage Users</p>
                    <a asp-page="/Users/Index" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>
    }
</div>