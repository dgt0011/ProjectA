@page
@model ProjectA.Web.Pages.Bookmarks.IndexModel
@{
    ViewData["Title"] = "Bookmarks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bookmarks</h1>
    <a asp-page="Create" class="btn btn-primary">Create bookmark</a>
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load bookmarks from the API.</div>
}
else if (Model.Bookmarks.Count == 0)
{
    <p class="text-muted">No bookmarks yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Url</th>
                <th>Rating</th>
                <th>Categories</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bookmark in Model.Bookmarks)
            {
                <tr>
                    <td>@bookmark.Title</td>
                    <td class="text-break"><a href="@bookmark.Url" target="_blank" rel="noopener">@bookmark.Url</a></td>
                    <td>@bookmark.Rating / 10</td>
                    <td>
                        @foreach (var categoryId in bookmark.CategoryIds)
                        {
                            <span class="badge bg-secondary me-1">@Model.CategoryTitle(categoryId)</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@bookmark.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@bookmark.Id" class="d-inline"
                              onsubmit="return confirm('Delete this bookmark?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
