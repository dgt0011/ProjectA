@page
@model ProjectA.Web.Pages.Bookmarks.IndexModel
@{
    ViewData["Title"] = "Bookmarks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bookmarks</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="Create" class="btn btn-primary">Create bookmark</a>
    }
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load bookmarks</div>
}
else if (Model.CategoryGroups.Count == 0)
{
    <p class="text-muted">No bookmarks yet.</p>
}
else
{
    <div class="accordion" id="bookmarksAccordion">
        @foreach (var group in Model.CategoryGroups)
        {
            var slug = group.CategoryId?.ToString() ?? "uncategorized";
            var headingId = $"heading-{slug}";
            var collapseId = $"collapse-{slug}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                        @group.CategoryTitle
                        <span class="badge bg-secondary ms-2">@group.Bookmarks.Count</span>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId">
                    <div class="accordion-body">
                        @if (group.Bookmarks.Count == 0)
                        {
                            <p class="text-muted">No bookmarks in this category.</p>
                        }
                        else
                        {
                            <div class="row row-cols-1 g-3">
                                @foreach (var bookmark in group.Bookmarks)
                                {
                                    var bookmarkType = Model.BookmarkType(bookmark.BookmarkTypeId);
                                    <div class="col">
                                        <div class="card h-100" style="@(!string.IsNullOrWhiteSpace(bookmarkType?.Color) ? $"background-color: {bookmarkType.Color};" : "")">
                                            <div class="card-body position-relative pb-5">
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    <div class="position-absolute top-0 end-0 p-2">
                                                        <a asp-page="Edit" asp-route-id="@bookmark.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                                        <form method="post" asp-page-handler="Delete" asp-route-id="@bookmark.Id" class="d-inline"
                                                              onsubmit="return confirm('Delete this bookmark?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                }
                                                <h5 class="card-title pe-5">
                                                    @if (bookmarkType is { HasIcon: true })
                                                    {
                                                        <img src="/bookmark-types/@bookmarkType.Id/icon" alt="@bookmarkType.Title" width="16" height="16" title="@bookmarkType.Title" class="me-1" />
                                                    }
                                                    @(string.IsNullOrWhiteSpace(bookmark.Title) ? bookmark.Url : bookmark.Title)
                                                </h5>
                                                <p class="card-text text-break">
                                                    <a href="@bookmark.Url" target="_blank" rel="noopener">@bookmark.Url</a>
                                                </p>
                                                @if (bookmark.CategoryIds.Count > 1)
                                                {
                                                    <p class="mb-0">
                                                        @foreach (var categoryId in bookmark.CategoryIds)
                                                        {
                                                            <span class="badge bg-secondary me-1">@Model.CategoryTitle(categoryId)</span>
                                                        }
                                                    </p>
                                                }
                                                @{
                                                    // 5 segments over a 1-10 scale - each segment covers 2 rating points,
                                                    // so e.g. a rating of 7 or 8 fills exactly 4 of the 5 segments.
                                                    var filledSegments = (bookmark.Rating + 1) / 2;
                                                }
                                                <div class="rating-bar position-absolute bottom-0 end-0 p-2" title="@bookmark.Rating / 10" aria-label="Rating: @bookmark.Rating out of 10">
                                                    @for (var i = 1; i <= 5; i++)
                                                    {
                                                        <span class="rating-segment @(i <= filledSegments ? "filled" : "")"></span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
