@page
@model ProjectA.Web.Pages.Users.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<h1>Change password</h1>

<p class="text-muted">
    This changes the password for the account you are currently signed in as (@User.Identity?.Name).
</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" class="col-md-4">
    <div class="mb-3">
        <label asp-for="Form.CurrentPassword" class="form-label"></label>
        <input asp-for="Form.CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="Form.CurrentPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.NewPassword" class="form-label"></label>
        <input asp-for="Form.NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Form.NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.ConfirmNewPassword" class="form-label"></label>
        <input asp-for="Form.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Form.ConfirmNewPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Change password</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>
