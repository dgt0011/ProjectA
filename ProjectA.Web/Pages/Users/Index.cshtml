@page
@model ProjectA.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Users</h1>
    <a asp-page="Create" class="btn btn-primary">Create user</a>
</div>

<p class="text-muted">
    There is no public sign-up page - new accounts are only ever created here, by someone who
    is already logged in.
</p>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load users from the API.</div>
}
else if (Model.Users.Count == 0)
{
    <p class="text-muted">No users yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Username</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.DateCreated.ToLocalTime().ToString("g")</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline"
                              onsubmit="return confirm('Delete this user?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
