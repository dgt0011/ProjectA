@page
@model ProjectA.Web.Pages.Attachments.IndexModel
@{
    ViewData["Title"] = "Attachments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Attachments</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="Create" class="btn btn-primary">Create attachment</a>
    }
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load attachments from the API.</div>
}
else if (Model.Attachments.Count == 0)
{
    <p class="text-muted">No attachments yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>File</th>
                <th>Created</th>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <th class="text-end">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model.Attachments)
            {
                <tr>
                    <td>@attachment.Title</td>
                    <td>@attachment.Description</td>
                    <td class="text-break"><a href="@attachment.FilePath" target="_blank" rel="noopener">@attachment.FilePath</a></td>
                    <td>@attachment.DateCreated.ToLocalTime().ToString("g")</td>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@attachment.Id" class="d-inline"
                                  onsubmit="return confirm('Delete this attachment?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
