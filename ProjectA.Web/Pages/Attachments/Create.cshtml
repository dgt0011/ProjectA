@page
@model ProjectA.Web.Pages.Attachments.CreateModel
@{
    ViewData["Title"] = "Create attachment";
}

<h1>Create attachment</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" enctype="multipart/form-data" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Description" class="form-label"></label>
        <textarea asp-for="Form.Description" class="form-control"></textarea>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UploadedFile" class="form-label">File</label>
        <input asp-for="UploadedFile" class="form-control" />
        <span asp-validation-for="UploadedFile" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>
