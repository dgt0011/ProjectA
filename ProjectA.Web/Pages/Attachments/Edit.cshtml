@page "{id:long}"
@model ProjectA.Web.Pages.Attachments.EditModel
@{
    ViewData["Title"] = "Edit attachment";
}

<h1>Edit attachment</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Description" class="form-label"></label>
        <textarea asp-for="Form.Description" class="form-control"></textarea>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.S3Arn" class="form-label"></label>
        <input asp-for="Form.S3Arn" class="form-control" />
        <span asp-validation-for="Form.S3Arn" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>
