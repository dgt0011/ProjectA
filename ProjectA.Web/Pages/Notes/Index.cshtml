@page
@model ProjectA.Web.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Notes</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="Create" class="btn btn-primary">Create note</a>
    }
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load notes.</div>
}
else if (Model.Notes.Count == 0)
{
    <p class="text-muted">No notes yet.</p>
}
else
{
    @if (Model.UsedCategories.Count > 0)
    {
        <div class="mb-3">
            <label for="noteCategoryFilterInput" class="form-label">Filter</label>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <input type="text" id="noteCategoryFilterInput" class="form-control" style="max-width: 260px;"
                       list="noteCategoryFilterOptions" autocomplete="off" placeholder="Type a category name..." />
                <datalist id="noteCategoryFilterOptions">
                    @foreach (var category in Model.UsedCategories)
                    {
                        <option data-id="@category.Id" value="@category.Title"></option>
                    }
                </datalist>
                <div id="noteCategoryFilterBadges" class="d-flex flex-wrap gap-1"></div>
            </div>
        </div>
        <p id="noNotesMatchFilterMessage" class="text-muted d-none">No notes match the selected categories.</p>
    }

    <div class="bs-component">
        @foreach (var note in Model.Notes)
        {
            <div class="row row-cols-1 note-row" data-category-ids="@string.Join(",", note.CategoryIds)">
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body position-relative">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                            <div class="position-absolute top-0 end-0 p-2">
                                <a asp-page="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@note.Id" class="d-inline"
                                      onsubmit="return confirm('Delete this note?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                            }
                            <h5 class="card-title pe-5">
                                <a asp-page="Details" asp-route-id="@note.Id">@(string.IsNullOrWhiteSpace(note.Title) ? "(untitled note)" : note.Title)</a>
                                @if (note.IsPrivate)
                                {
                                    <span class="badge text-bg-secondary ms-1">Private</span>
                                }
                            </h5>
                            <p class="card-text text-break">
                                @note.Description
                            </p>

                            @if (note.CategoryIds.Count > 0)
                            {
                                <p>
                                    @foreach (var id in note.CategoryIds)
                                    {
                                        <span class="badge bg-secondary">@Model.CategoryTitle(id)</span>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
