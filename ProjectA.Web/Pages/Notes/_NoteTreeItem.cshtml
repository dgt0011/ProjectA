@model ProjectA.Web.Models.NoteTreeItemViewModel
@{
    var note = Model.Note;
    var children = Model.ChildrenByParentId.TryGetValue(note.Id, out var kids) ? kids : [];
    var collapseId = $"note-collapse-{note.Id}";
}

@* Inset by Depth so nested children are visually indented under their parent, per the
   "small distance" hierarchical layout requirement. Each node starts expanded (matching the
   main note on the Details page) and can be individually collapsed down to just its Title,
   Date Created and Date Modified via the toggle button. *@
<div class="card mb-2" style="margin-left: @(Model.Depth * 24)px;">
    <div class="card-body py-2 position-relative">
        @* Edit is an absolutely-positioned overlay, a sibling of the toggle row below rather
           than nested inside it - Bootstrap's collapse toggle is wired up via a click listener
           on document registered with useCapture (so it always sees event.target.closest
           first, before any descendant's own click handler runs), so a stopPropagation() call
           on a link nested inside the toggle row can't stop it from also toggling the collapse.
           Keeping Edit out of that row entirely avoids the problem structurally instead. Only
           rendered when a ReturnUrl was supplied - i.e. reached via a Project's Details page
           (see _ProjectNoteItem); the standalone Notes/Details page's own child-tree display
           is unchanged. *@
        @if (Model.ReturnUrl is not null && User.Identity?.IsAuthenticated == true)
        {
            <div class="position-absolute top-0 end-0 p-2">
                <a asp-page="/Notes/Edit" asp-route-id="@note.Id" asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-sm btn-outline-secondary">Edit</a>
            </div>
        }
        @* The whole header row doubles as the toggle now (not just the icon button) - matches
           the same "click the whole collapsed card" behavior as _ProjectNoteItem. *@
        <div class="d-flex justify-content-between align-items-start pe-5"
             data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor: pointer;">
            <div class="d-flex align-items-center">
                <button class="btn btn-sm btn-link p-0 me-2" type="button" data-bs-toggle="collapse"
                        data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId" aria-label="Collapse note">
                    <img src="~/img/collapse.png" alt="" class="collapse-toggle-icon" width="16" height="16" />
                </button>
                <strong>@(string.IsNullOrWhiteSpace(note.Title) ? "(untitled note)" : note.Title)</strong>
                @if (note.IsPrivate)
                {
                    <span class="badge text-bg-secondary ms-2">Private</span>
                }
            </div>
            <div class="text-muted small text-end">
                Created @note.DateCreated.ToLocalTime().ToString("g")
                @if (note.DateModified is { } modified)
                {
                    <text>&middot; Modified @modified.ToLocalTime().ToString("g")</text>
                }
            </div>
        </div>

        <div class="collapse show note-collapse mt-2" id="@collapseId">
            @if (!string.IsNullOrWhiteSpace(note.Description))
            {
                <p class="text-muted mb-1">@note.Description</p>
            }
            @if (!string.IsNullOrWhiteSpace(note.Body))
            {
                <textarea class="d-none note-tree-body-raw" data-note-id="@note.Id">@note.Body</textarea>
                <div class="border rounded p-2 note-tree-body-rendered" data-note-id="@note.Id"></div>
            }
            <!-- 
            <a asp-page="/Notes/Details" asp-route-id="@note.Id" class="small d-inline-block mt-1">Open as its own note</a>
            -->
            
            @if (children.Count > 0)
            {
                <div class="mt-2">
                    @foreach (var child in children)
                    {
                        @* Absolute path, not just "_NoteTreeItem" - a bare name resolves relative to
                           whichever page originally started this render, which is no longer always
                           a page under /Pages/Notes/ now that Projects/Details also renders this
                           partial (via _ProjectNoteItem), so a same-folder-relative lookup would
                           fail as soon as recursion went one level deeper from there. *@
                        <partial name="/Pages/Notes/_NoteTreeItem.cshtml" model="@(new NoteTreeItemViewModel { Note = child, ChildrenByParentId = Model.ChildrenByParentId, Depth = Model.Depth + 1, ReturnUrl = Model.ReturnUrl })" />
                    }
                </div>
            }
        </div>
    </div>
</div>
