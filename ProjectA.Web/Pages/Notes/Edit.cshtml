@page "{id:long}"
@model ProjectA.Web.Pages.Notes.EditModel
@{
    ViewData["Title"] = "Edit note";
}

<h1>Edit note</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" class="col-md-8">
    <div class="mb-3">
        <label asp-for="Form.Title" class="form-label"></label>
        <input asp-for="Form.Title" class="form-control" />
        <span asp-validation-for="Form.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Form.Body" class="form-label"></label>
        <textarea asp-for="Form.Body" class="form-control" rows="12"></textarea>
        <span asp-validation-for="Form.Body" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_MarkdownEditorScripts" />
}
