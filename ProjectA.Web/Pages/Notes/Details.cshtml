@page "{id:long}"
@model ProjectA.Web.Pages.Notes.DetailsModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Note?.Title) ? "Note" : Model.Note.Title;
    var mainChildren = Model.Note is not null && Model.ChildrenByParentId.TryGetValue(Model.Note.Id, out var kids)
        ? kids
        : [];
}

@if (Model.Note is null)
{
    <div class="alert alert-warning">Could not load this note from the API.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <button class="btn btn-sm btn-link p-0 me-2" type="button" data-bs-toggle="collapse"
                    data-bs-target="#note-collapse-main" aria-expanded="true" aria-controls="note-collapse-main">
                <span class="collapse-toggle-icon">&minus;</span>
            </button>
            <h1 class="mb-0">@(string.IsNullOrWhiteSpace(Model.Note.Title) ? "(untitled note)" : Model.Note.Title)</h1>
            @if (Model.Note.IsPrivate)
            {
                <span class="badge text-bg-secondary ms-2">Private</span>
            }
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="Edit" asp-route-id="@Model.Note.Id" class="btn btn-outline-secondary">Edit</a>
        }
    </div>

    <p class="text-muted small">
        Created @Model.Note.DateCreated.ToLocalTime().ToString("g")
        @if (Model.Note.DateModified is { } modified)
        {
            <text>&middot; Last modified @modified.ToLocalTime().ToString("g")</text>
        }
    </p>

    <div class="collapse show note-collapse" id="note-collapse-main">
        @if (!string.IsNullOrWhiteSpace(Model.Note.Description))
        {
            <p class="lead text-muted">@Model.Note.Description</p>
        }

        <textarea id="note-body-raw" class="d-none">@Model.Note.Body</textarea>
        <div id="note-body-rendered" class="border rounded p-3"></div>

        @if (Model.AssociatedBookmarks.Count > 0)
        {
            <div class="mt-4">
                <h2 class="h5">References</h2>

                <ul class="list-group">
                    @foreach (var bookmark in Model.AssociatedBookmarks)
                    {
                        <li class="list-group-item">
                            <a href="@bookmark.Url" target="_blank" rel="noopener">
                                @(string.IsNullOrWhiteSpace(bookmark.Title) ? bookmark.Url : bookmark.Title)
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.AssociatedAttachments.Count > 0)
        {
            <div class="mt-4">
                <h2 class="h5">Attachments</h2>
                <ul class="list-group">
                    @foreach (var attachment in Model.AssociatedAttachments)
                    {
                        <li class="list-group-item">
                            @(string.IsNullOrWhiteSpace(attachment.Title) ? "(untitled attachment)" : attachment.Title)
                            <code class="text-muted ms-2">@attachment.S3Arn</code>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (mainChildren.Count > 0)
        {
            <div class="mt-4">
                <h2 class="h5">Child notes</h2>
                @foreach (var child in mainChildren)
                {
                    <partial name="_NoteTreeItem" model="@(new NoteTreeItemViewModel { Note = child, ChildrenByParentId = Model.ChildrenByParentId, Depth = 1 })" />
                }
            </div>
        }
    </div>

    <p class="mt-3">
        <a asp-page="Index" class="btn btn-link ps-0">Back to Notes</a>
    </p>
}

@section Scripts {
    <partial name="_MarkdownViewerScripts" />
    <partial name="_NoteTreeScripts" />
}
