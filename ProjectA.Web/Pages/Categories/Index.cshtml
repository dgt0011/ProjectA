@page
@model ProjectA.Web.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categories</h1>
    <a asp-page="Create" class="btn btn-primary">Create category</a>
</div>

@if (!Model.LoadedSuccessfully)
{
    <div class="alert alert-warning">Could not load categories from the API.</div>
}
else if (Model.Categories.Count == 0)
{
    <p class="text-muted">No categories yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Title</td>
                    <td>@category.Description</td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
