server {
    listen 80;
    listen [::]:80;

    server_name {{ nginx_server_name }};

    # permit large file uploads for this site
    client_max_body_size 100M;

    # This is the bootstrap, HTTP-only vhost. Once the letsencrypt role has
    # obtained a certificate it overwrites this same file with an
    # HTTPS-enabled version (see deploy/ansible/letsencrypt/templates/vhost-ssl.conf.j2).
    # It's kept here too so the site is reachable over plain HTTP - and
    # certbot's --nginx authenticator has an existing server block to work
    # with - on the very first run, before any certificate exists.
    location / {
        proxy_pass http://{{ nginx_upstream_host }}:{{ nginx_upstream_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
