@inject ProjectA.Blog.Web.Services.IBlogApiClient BlogApi
@*
    Blogifier's "standard" theme layout (layouts/_main + components/header, nav, footer) as
    rendered by the live darrentuer.net site, so the blog keeps its existing look. Pages set:
      ViewData["Title"]       - page title (omitted on the home page)
      ViewData["Description"] - meta description (defaults to the blog description)
      ViewData["Canonical"]   - site-relative canonical path (defaults to the site root)
    and may render a "JsonLd" section.
*@
@{
    var site = await BlogApi.GetSiteAsync(Context.RequestAborted);
    var request = Context.Request;
    var absoluteUrl = $"{request.Scheme}://{request.Host.ToUriComponent()}{request.PathBase.ToUriComponent()}";
    var title = ViewData["Title"] as string;
    var pageTitle = title is null ? $"{site.Title} | {site.Description}" : $"{title} | {site.Title}";
    // Posts with no description pass "" - fall back to the blog's description then too.
    var pageDescription = ViewData["Description"] is string description && !string.IsNullOrWhiteSpace(description)
        ? description
        : site.Description;
    var canonical = absoluteUrl + (ViewData["Canonical"] as string ?? string.Empty);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription">
    <link rel="alternate" type="application/rss+xml" title="@site.Title" href="@absoluteUrl/feed/rss" />
    <link rel="canonical" href="@canonical" />
    @* No favicon: an empty data: icon stops browsers requesting /favicon.ico (which would 404). *@
    <link rel="icon" href="data:,">

    @Html.Raw(site.HeaderScript)

    <style>
        :root {
            /* accent color */
            --bf-color: #622aff;
            /* header */
            --bf-header-title-size: 1.5rem;
            --bf-header-title-weight: 700;
            --bf-header-title-color: #000;
            --bf-header-title-hover: #622aff;
            /* logo */
            --bf-header-logo-width: auto;
            --bf-header-logo-height: 1.5rem;
            /* post */
            --bf-post-width: 43.75rem;
            /* radius */
            --bf-radius: .5rem;
        }
    </style>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    <link rel="stylesheet" href="~/themes/standard/css/styles.css" asp-append-version="true">
</head>

<body>

<header class="header">
    <div class="container d-md-flex align-items-md-center">
        <section class="header-sign py-4 py-md-0 text-center text-md-start me-md-auto">
            <a class="header-title" href="@absoluteUrl">@site.Title</a>
            <p class="header-desc">@site.Description</p>
        </section>

        <nav class="header-nav d-flex">

            <!-- Topics -->
            @if (site.Categories.Count > 0)
            {
                <div class="dropdown me-auto me-md-0">
                    <button class="header-nav-link" type="button" id="mainNav" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="me-1">categories</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                        </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="mainNav">
                        @foreach (var category in site.Categories)
                        {
                            <li><a class="dropdown-item" href="/categories/@Uri.EscapeDataString(category.Title)">@category.Title</a></li>
                        }
                    </ul>
                </div>
            }
            <!--/Topics -->

            <!-- Social -->
            <ul class="social d-flex ms-2" aria-label="social-accounts">
            </ul>
            <!--/social -->

            <!-- Search button -->
            <button aria-label="search" class="header-nav-button d-none d-md-block" type="button" data-bs-toggle="modal" data-bs-target="#searchModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                </svg>
            </button>
            <!--/Search button -->

        </nav>
    </div>
</header>

@RenderBody()

<div class="modal fade search-modal" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
    <div class="modal-dialog mt-5">
        <div class="modal-content">
            <form id="searchForm" class="search-form" method="get" action="/search">
                <input type="search" id="searchFormInput" name="term" class="form-control form-control-lg border-0 shadow-none" placeholder="search..." autocomplete="off" autofocus>
            </form>
        </div>
    </div>
</div>

<footer class="container">
    <section class="footer d-md-flex text-center text-md-start py-4 py-md-5">
        <p>&copy; @DateTime.UtcNow.Year - @site.Title</p>
    </section>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/js/bootstrap.bundle.min.js" integrity="sha384-b5kHyXgcpbZJO/tY9Ul7kGkf1S0CWuKcCD38l8YkeH8z8QjE0GmW1gYU5S9FOnJ0" crossorigin="anonymous"></script>
<script src="~/themes/standard/js/highlight.js" asp-append-version="true"></script>
<script src="~/themes/standard/js/scripts.js" asp-append-version="true"></script>

@Html.Raw(site.FooterScript)
@await RenderSectionAsync("JsonLd", required: false)
</body>
</html>
