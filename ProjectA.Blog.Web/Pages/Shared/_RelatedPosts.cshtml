@model (List<PostSummary> Related, string DefaultCover)
@* Blogifier standard theme: post/related.cshtml (grid cards), as rendered on the live site. *@
@if (Model.Related.Count > 0)
{
    <section class="related">
        <header class="related-header">
            <h3 class="related-header-title">Related Posts</h3>
            <a class="related-header-link ms-auto" href="/">
                View All
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                </svg>
            </a>
        </header>

        <div class="row">
            @foreach (var post in Model.Related)
            {
                var url = BlogFormat.PostPath(post.PostType, post.Slug);
                <div class="col-12 col-md mb-4 mb-md-0">
                    <article class="post-grid d-flex flex-column">
                        <figure class="post-grid-cover" aria-hidden="true">
                            <img class="post-grid-img" src="@BlogFormat.AssetUrl(post.Cover, Model.DefaultCover)" alt="@post.Title">
                        </figure>
                        <div class="post-grid-cats">
                            @foreach (var category in post.Categories)
                            {
                                <a class="post-grid-cats-link" href="/categories/@Uri.EscapeDataString(category.Title)" tabindex="-1">@category.Title</a>
                            }
                        </div>
                        <h2 class="post-grid-title">
                            <a class="post-grid-link" href="@url">@post.Title</a>
                        </h2>
                        <p class="post-grid-desc">@post.Description</p>
                        <div class="post-grid-meta d-flex">
                            <div class="post-grid-date">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="bi bi-calendar-event post-grid-date-icon" viewBox="0 0 16 16">
                                    <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                                </svg>
                                <time class="post-grid-date-time">@BlogFormat.FriendlyDate(post.PublishedAt)</time>
                            </div>
                            <a class="post-grid-more ms-auto" href="@url" tabindex="-1">
                                <span>Read</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right-short" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                                </svg>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}
